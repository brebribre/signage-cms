{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend"
      ],
      "port": 5173
    },
    {
      "name": "web-player",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "cd web-player && npm run build && PORT=4184 BACKEND_URL=http://localhost:8001 node server.mjs"
      ],
      "port": 4184
    },
    {
      "name": "web-player-dev",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "web-player"
      ],
      "port": 5174
    },
    {
      "name": "website",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "website"
      ],
      "port": 5175
    },
    {
      "name": "monitoring",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "monitoring"
      ],
      "port": 5176,
      "url": "http://127.0.0.1:5176"
    }
  ]
}
