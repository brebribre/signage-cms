# Copy this file to backend/.env and fill in the blanks.
# .env is gitignored; this file is committed, so it must never hold a real value.
#   cp backend/.env.example backend/.env

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Local Postgres from docker-compose.yml. Host port 5434, not 5432 or 5433 —
# 5433 is strava-comp's, and both projects should be able to run at once.
# Railway injects its own DATABASE_URL as `postgresql://...`; config.py rewrites
# the scheme to `postgresql+psycopg://` because psycopg2 is not installed.
DATABASE_URL=postgresql+psycopg://signage:signage@localhost:5434/signage

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------
# Signs the session cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
SESSION_COOKIE_NAME=scms_session
SESSION_MAX_AGE_SECONDS=2592000

# true in production (HTTPS only). Must be true whenever COOKIE_SAMESITE=none.
COOKIE_SECURE=false

# "lax" while the frontend and API share a site. "none" once they are on
# different domains — browsers honour "none" only together with Secure=true, and
# drop the cookie SILENTLY otherwise, which looks like broken auth, not like CORS.
COOKIE_SAMESITE=lax

# ---------------------------------------------------------------------------
# Cloudflare R2  (bucket: fortu-cms)
# ---------------------------------------------------------------------------
# Dashboard -> R2 object storage -> API tokens -> Create API token
#   * Account API token, NOT a User token (a User token dies with the user)
#   * Permission: Object Read & Write — Admin cannot be scoped to one bucket
#   * Scope it to the fortu-cms bucket only
#
# The Secret Access Key is displayed ONCE. The separate "Token value" shown on
# that page is for Cloudflare's REST API and is NOT what boto3 wants — the S3
# credentials are the two Key values below.
#
# The endpoint and bucket are not secrets; the two keys are.
R2_ENDPOINT_URL=https://74c0ceb3565715dd70bbe3d4f585412f.r2.cloudflarestorage.com
R2_BUCKET=fortu-cms
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# ---------------------------------------------------------------------------
# Media
# ---------------------------------------------------------------------------
MEDIA_MAX_BYTES=524288000           # 500 MB
PRESIGN_PUT_TTL_SECONDS=3600        # how long a browser has to finish an upload
PRESIGN_GET_TTL_SECONDS=3600        # CMS preview URLs
DEVICE_PRESIGN_TTL_SECONDS=21600    # 6h — a screen may be downloading over bad wifi

# ---------------------------------------------------------------------------
# Devices
# ---------------------------------------------------------------------------
PAIRING_CODE_TTL_SECONDS=900        # 15 min before an unclaimed code expires
DEVICE_POLL_SECONDS=30              # advertised to the player; also the manifest cache hint

# ---------------------------------------------------------------------------
# CORS
# ---------------------------------------------------------------------------
FRONTEND_ORIGIN=http://localhost:5173
# Comma-separated extras, e.g. the deployed frontend URL.
EXTRA_CORS_ORIGINS=

LOG_LEVEL=INFO
