<?xml version="1.0" encoding="utf-8"?>
<!--
  A SurfaceView-backed PlayerView — the default, and the one that keeps a 4K video at 4K.

  A SurfaceView hands decoded frames to the display's own compositor, so the panel scales them
  itself; a TextureView (see pooled_player_view.xml) draws every frame into the app's window
  through the GPU first, capping the video at the window's resolution and filtering it bilinearly
  on the way. On a 4K panel that is visibly softer, and it costs GPU that a cheap signage SoC
  does not have to spare.

  It is only safe where nothing else shares the frame: a SurfaceView does not reliably respect
  an AndroidView's Compose bounds or z-order, which is why multi-element scenes still use
  pooled_player_view.xml. PlaybackSurface.kt picks between the two per playlist.
-->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pooled_player_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="surface_view"
    app:use_controller="false" />
