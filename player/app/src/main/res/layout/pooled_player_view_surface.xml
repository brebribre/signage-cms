<?xml version="1.0" encoding="utf-8"?>
<!--
  A SurfaceView-backed PlayerView — the default, for full-bleed videos and scenes alike.

  A SurfaceView hands decoded frames to the display's own compositor, so the panel scales them
  itself and the app's window is never redrawn for them: a 4K video stays 4K, and a picture
  or text sharing the scene costs the video nothing. A TextureView (pooled_player_view.xml)
  draws every frame into the app's window through the GPU first, capping the video at the
  window's resolution and re-compositing the whole scene per frame — visibly softer on a 4K
  panel and, on a cheap signage SoC, enough to drop the video's frame rate.

  In a scene the surface sits below the window and punches a hole its own size; elements
  painted later in z-order draw over that hole, and elements below it are covered by the
  video anyway. What it cannot do is follow a Compose graphics layer, so a playlist with a
  rotated video keeps pooled_player_view.xml throughout. PlaybackSurface.kt picks per playlist.
-->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pooled_player_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="surface_view"
    app:use_controller="false" />
