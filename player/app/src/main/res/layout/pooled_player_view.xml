<?xml version="1.0" encoding="utf-8"?>
<!--
  A TextureView-backed PlayerView, used only for a playlist that rotates a video somewhere.

  A rotation is a Compose graphics layer, and a SurfaceView (pooled_player_view_surface.xml)
  is composited by the display outside the app's window, so it cannot follow one. A
  TextureView is a plain View drawn through the window, so it turns with its box — at the
  cost of the GPU copying every video frame into the window, which is why it is not the
  default: on a cheap signage SoC that copy is what makes a video stutter.
-->
<androidx.media3.ui.PlayerView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/pooled_player_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    app:surface_type="texture_view"
    app:use_controller="false" />
