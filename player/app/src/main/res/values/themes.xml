<resources>
    <!-- No action bar, black window background: a signage screen shows content edge to edge
         and letterboxes against black, never against a theme colour. -->
    <style name="Theme.FortuPlayer" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
