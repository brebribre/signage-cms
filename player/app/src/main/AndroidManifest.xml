<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Silent self-update as Device Owner (Phase 12c). Harmless on a non-owner install,
         where SelfUpdater declines to run at all. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Remote brightness (kiosk/DeviceSettingsApplier.kt). Declaring it doesn't grant it —
         a non-owner install still can't write SCREEN_BRIGHTNESS without a trip through the
         system's "Modify system settings" screen, which nothing here drives it through, so
         brightness only actually applies on a Device Owner install, same as everything else
         gated by KioskPolicy.isDeviceOwner. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />

    <application
        android:allowBackup="false"
        android:usesCleartextTraffic="${usesCleartextTraffic}"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.FortuPlayer">

        <!--
          No `screenOrientation` here on purpose. The orientation is set per screen in the
          CMS and arrives in the manifest, so the activity applies it at runtime instead of
          being hard-locked at build time. A single APK therefore serves portrait totems and
          landscape panels without a separate build for each.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|uiMode"
            android:launchMode="singleTask"
            android:theme="@style/Theme.FortuPlayer">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              HOME + DEFAULT makes this app selectable as the device's launcher, which is the
              simplest real kiosk: the screen boots straight into the player and the Home
              button returns to it instead of escaping to a desktop. Commented out by default
              so a development install does not hijack your phone — uncomment for hardware
              you are dedicating to signage. Device Owner mode (see player/README.md) is the
              stronger option where you can factory-reset the device.
            -->
            <!--
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            -->
        </activity>

        <!--
          The component `dpm set-device-owner` targets. Its presence is what makes Device
          Owner provisioning possible; without it the command has nothing to point at.
        -->
        <receiver
            android:name=".kiosk.DeviceAdminReceiver"
            android:permission="android.permission.BIND_DEVICE_ADMIN"
            android:exported="true">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".kiosk.UpdateResultReceiver"
            android:exported="false" />

        <!--
          Deliberately no BOOT_COMPLETED here: the player does not open itself after a reboot,
          so a screen can be used for something else. See RelaunchReceiver.
        -->
        <receiver
            android:name=".RelaunchReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter android:priority="1000">
                <!-- Delivered to the *new* build after a self-update replaces this app — the
                     one signal guaranteed to arrive, since the installer's own result goes to
                     the build that was just killed. See RelaunchReceiver. -->
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
