# --- Environment (never commit a filled-in .env) ---
.env
.env.local
.env.*.local
!.env.example

# --- MQTT broker TLS private key (mosquitto/certs/server.crt is fine — clients only need
# the public cert to pin; the key is what lets anyone impersonate the broker). Never in git,
# never in the Docker image — the mqtt-broker service reads it from the MQTT_TLS_KEY_PEM
# Railway variable at container start instead (see mosquitto/entrypoint.sh). ---
mosquitto/certs/server.key

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# --- Node / frontend ---
node_modules/
dist/
dist-ssr/
*.tsbuildinfo

# --- Android player ---
.gradle/
build/
local.properties
captures/
*.apk
*.aab
*.keystore
*.jks

